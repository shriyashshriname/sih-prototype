NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://aegis:aegis_password@db:5432/aegis_db
JWT_SECRET=aegis-super-secret-key-change-in-production
AI_ENGINE_URL=http://ai-engine:8000
REDIS_URL=redis://redis:6379
CLIENT_URL=http://localhost:5173
OPENWEATHER_API_KEY=your_key_here

# PostgreSQL Credentials (used by db container)
POSTGRES_DB=aegis_db
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_password
